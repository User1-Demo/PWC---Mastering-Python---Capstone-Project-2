APP_ENV=development
DATABASE_URL=sqlite:///./cloudguard.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60
AZURE_PROVIDER=mock
EXECUTION_MODE=inline
WORKER_IMAGE=cloudguard:latest
KUBERNETES_NAMESPACE=cloudguard
KUBERNETES_SECRET_NAME=cloudguard-secrets
DEFAULT_REQUIRED_TAGS=owner,environment,cost-center
AUTO_REMEDIATE_LOW_RISK=true
REMEDIATION_MAX_RETRIES=3
REMEDIATION_RETRY_BASE_SECONDS=1
KEY_VAULT_EXPIRY_DAYS=30
IDLE_CPU_THRESHOLD_PERCENT=5
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
