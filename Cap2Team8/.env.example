APP_NAME=CloudGuard
APP_ENV=development
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://cloudguard:ChangeThisDbPassword@localhost:5432/cloudguard
JWT_SECRET_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRE_MINUTES=60

# Azure subscription to scan
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# Client ID of the User-Assigned Managed Identity
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Keep false when running on an Azure host with the UAMI attached.
# Set true only for offline/mock testing; no real Azure resources will be changed.
CLOUDGUARD_AZURE_MOCK=false

# Development-only seed accounts. Change these before using outside local testing.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123!
SEED_ENGINEER_USERNAME=engineer
SEED_ENGINEER_PASSWORD=ChangeMe_Engineer_123!
SEED_SECURITY_USERNAME=security
SEED_SECURITY_PASSWORD=ChangeMe_Security_123!
