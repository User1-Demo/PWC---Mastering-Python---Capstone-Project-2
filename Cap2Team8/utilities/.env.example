APP_NAME=CloudGuard
APP_ENV=production
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://cloudguard:replace-with-url-safe-password@postgres:5432/cloudguard
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=60

POSTGRES_DB=cloudguard
POSTGRES_USER=cloudguard
POSTGRES_PASSWORD=replace-with-url-safe-password

AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
CLOUDGUARD_AZURE_MOCK=true

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_ENGINEER_USERNAME=engineer
SEED_ENGINEER_PASSWORD=replace-with-a-strong-password
SEED_SECURITY_USERNAME=security
SEED_SECURITY_PASSWORD=replace-with-a-strong-password
